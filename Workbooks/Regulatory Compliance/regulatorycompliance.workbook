                  "version": "KqlParameterItem/1.0",
                  "name": "WorkloadDetailInGlobal",
                  "type": 1,
                  "isRequired": true,
                  "isHiddenWhenLocked": true,
                  "criteriaData": [
                    {
                      "criteriaContext": {
                        "leftOperand": "WorkloadDetailSubscription",
                        "operator": "is Empty",
                        "resultValType": "static",
                        "resultVal": "no"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "Subscription",
                        "operator": "contains",
                        "rightValType": "static",
                        "rightVal": "value::all",
                        "resultValType": "static",
                        "resultVal": "yes"
                      }
                    },
                    {
                      "criteriaContext": {
                        "leftOperand": "Subscription",
                        "operator": "contains",
                        "rightValType": "param",
                        "rightVal": "WorkloadDetailSubscription",
                        "resultValType": "static",
                        "resultVal": "yes"
                      }
                    },
                    {
                      "criteriaContext": {
                        "operator": "Default",
