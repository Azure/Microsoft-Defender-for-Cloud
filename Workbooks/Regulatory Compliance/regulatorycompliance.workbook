 Other = countif(ControlState !in ('Passed', 'Failed')) by SourceSubscription, Standard, SnapshotDay\r\n) on SourceSubscription, Standard, SnapshotDay\r\n| extend Passed = coalesce(Passed, 0), Failed = coalesce(Failed, 0), Other = coalesce(Other, 0)\r\n| extend Assessed = Passed + Failed\r\n| extend PassPercent = iff(Assessed > 0 and IncompleteRecords == 0, 100.0 * Passed / Assessed, real(null));\r\nlet LatestDays = SnapshotDays\r\n| summarize LatestDay = max(SnapshotDay) by SourceSubscription, Standard;\r\nlet PairDays = SnapshotDays\r\n| join kind=inner (LatestDays) on SourceSubscription, Standard\r\n| summarize LatestDay = max(LatestDay), PreviousDay = maxif(SnapshotDay, SnapshotDay < LatestDay), ObservedDays = count() by SourceSubscription, Standard;\r\nlet CurrentControls = ControlDays\r\n| join kind=inner (PairDays | where isnotnull(PreviousDay)) on SourceSubscription, Standard\r\n| where SnapshotDay == LatestDay\r\n| project SourceSubscription, Standard, ControlId, CurrentState = ControlState;\r\nlet PreviousControls = ControlDays\r\n| join kind=inner (PairDays | where isnotnull(PreviousDay)) on SourceSubscription, Standard\r\n| where SnapshotDay == PreviousDay\r\n| project PreviousSubscription = SourceSubscription, PreviousStandard = Standard, PreviousControl = ControlId, PreviousState = ControlState;\r\nlet ControlComparison = CurrentControls\r\n| join kind=fullouter (PreviousControls) on $left.SourceSubscription == $right.PreviousSubscription, $left.Standard == $right.PreviousStandard, $left.ControlId == $right.PreviousControl\r\n| extend SourceSubscription = coalesce(SourceSubscription, PreviousSubscription), Standard = coalesce(Standard, PreviousStandard), ControlId = coalesce(ControlId, PreviousControl)\r\n| extend Comparable = CurrentState in ('Passed', 'Failed') and PreviousState in ('Passed', 'Failed')\r\n| extend Change = case(isempty(CurrentState), 'Not observed in latest snapshot', isempty(PreviousState), 'Newly observed control', CurrentState == 