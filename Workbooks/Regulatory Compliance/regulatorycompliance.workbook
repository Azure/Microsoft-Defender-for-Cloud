          {
            "type": 3,
            "name": "ReadinessAutomationDataTypes",
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\n| where type =~ 'microsoft.resources/subscriptions'\n| project subscriptionId = tolower(subscriptionId), Subscription = name, SubscriptionResourceId = id\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.security/automations'\n    | extend subscriptionId = tolower(subscriptionId), Automation = name, AutomationId = id,\n        EnabledValue = tolower(tostring(properties.isEnabled)), SourceCount = array_length(properties.sources)\n    | extend SourceList = iff(isnull(SourceCount) or SourceCount == 0 or SourceCount > 2000, dynamic([{}]), properties.sources)\n    | mv-expand Source = SourceList limit 2000\n    | extend EventSource = tolower(tostring(Source.eventSource)), RuleSetCount = array_length(Source.ruleSets)\n    | summarize ConfiguredSources = make_set_if(EventSource, isnotempty(EventSource)),\n    FilteredSources = make_set_if(EventSource, isnotempty(EventSource) and RuleSetCount > 0),\n    MalformedSources = countif(SourceCount > 0 and isempty(EventSource)),\n    InvalidRuleSets = countif(isnotnull(Source.ruleSets) and isnull(RuleSetCount)),\n    UnknownSources = make_set_if(EventSource, isnotempty(EventSource) and EventSource !in ('assessments', 'subassessments', 'alerts', 'securescores', 'securescorecontrols', 'regulatorycomplianceassessment', 'attackpaths', 'assessmentssnapshot', 'subassessmentssnapshot', 'securescoressnapshot', 'securescorecontrolssnapshot', 'regulatorycomplianceassessmentsnapshot', 'attackpathssnapshot'))\n        by subscriptionId, Automation, AutomationId, EnabledValue, SourceCount\n) on subscriptionId\n| extend Automation = iff(isempty(AutomationId), 'Not observed', Automation),\n    Enabled = case(isempty(AutomationId), 'Not observed', EnabledValue == 'true', 'On', EnabledValue == 'false', 'Off', 'Unknown / not reported')\n| extend Automation = case(Automation == 'Not observed', Automation,\n    AutomationId matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(resourcegroups/[^/]+/)?providers/microsoft[.]security/automations/[^/]+/?$', AutomationId,\n    strcat('Unresolved: ', Automation))\n| extend DataTypes = dynamic([\n    {'DataType':'Security recommendations','StreamingEvents':['assessments','subassessments'],'SnapshotEvents':['assessmentssnapshot','subassessmentssnapshot']},\n    {'DataType':'Secure score','StreamingEvents':['securescores','securescorecontrols'],'SnapshotEvents':['securescoressnapshot','securescorecontrolssnapshot']},\n    {'DataType':'Security alerts','StreamingEvents':['alerts'],'SnapshotEvents':[]},\n    {'DataType':'Regulatory compliance','StreamingEvents':['regulatorycomplianceassessment'],'SnapshotEvents':['regulatorycomplianceassessmentsnapshot']},\n    {'DataType':'Security attack paths','StreamingEvents':['attackpaths'],'SnapshotEvents':['attackpathssnapshot']}\n])\n| mv-expand DataTypeItem = DataTypes\n| extend DataType = tostring(DataTypeItem.DataType),\n    StreamingEvents = DataTypeItem.StreamingEvents, SnapshotEvents = DataTypeItem.SnapshotEvents\n| extend StreamingFound = array_length(set_intersect(ConfiguredSources, StreamingEvents)),\n    StreamingExpected = array_length(StreamingEvents),\n    StreamingFiltered = array_length(set_intersect(FilteredSources, StreamingEvents)),\n    SnapshotFound = array_length(set_intersect(ConfiguredSources, SnapshotEvents)),\n    SnapshotExpected = array_length(SnapshotEvents),\n    SnapshotFiltered = array_length(set_intersect(FilteredSources, SnapshotEvents)),\n    InventoryComplete = isnotnull(SourceCount) and SourceCount <= 2000 and MalformedSources == 0 and InvalidRuleSets == 0\n| extend StreamingStatus = case(isempty(AutomationId), 'Not observed',\n    not(InventoryComplete), 'Unknown / review',\n    StreamingFound == 0, 'Off',\n    StreamingFound < StreamingExpected, 'Partially on',\n    StreamingFiltered > 0, 'On (filtered)', 'On'),\n    SnapshotStatus = case(isempty(AutomationId), 'Not observed',\n    SnapshotExpected == 0, 'Not applicable',\n    not(InventoryComplete), 'Unknown / review',\n    SnapshotFound == 0, 'Off',\n    SnapshotFound < SnapshotExpected, 'Partially on',\n    SnapshotFiltered > 0, 'On (filtered)', 'On')\n| extend Review = case(isempty(AutomationId), 'No visible automation; verify read access.',\n    isnull(SourceCount), 'Source list not reported; item states are unknown.',\n    SourceCount > 2000, 'Source list exceeds 2000 entries; item states are unknown.',\n    MalformedSources > 0 or InvalidRuleSets > 0, 'Malformed source or rule-set data; item states are unknown.',\n    array_length(UnknownSources) > 0, 'Unmapped event source exists; review the detailed source inventory.',\n    'Source configuration only. Export enablement and delivery are shown separately.')\n| project Subscription, SubscriptionResourceId, Automation, AutomationId, Enabled, DataType,\n    StreamingStatus, SnapshotStatus, Review, subscriptionId\n| order by Subscription asc, Automation asc, DataType asc\n",
              "size": 3,
              "title": "Export data types by automation — configured on/off",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "noDataMessage": "No subscription automation data was returned. Check subscription scope and Reader permissions.",
              "noDataMessageStyle": 2,
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "gridSettings": {
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "Enabled",
                    "label": "Automation enabled"
                  },
                  {
                    "columnId": "DataType",
                    "label": "Exported data type"
                  },
                  {
                    "columnId": "StreamingStatus",
