                    "label": "Inventory / delivery note"
                  },
                  {
                    "columnId": "AutomationId",
                    "label": "Automation ID"
                  },
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  }
                ],
                "formatters": [
                  {
                    "columnMatch": "Subscription",
                    "formatter": 1,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkColumn": "SubscriptionResourceId"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionResourceId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Automation",
                    "formatter": 13,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "showIcon": true,
                      "customColumnWidthSetting": "28ch",
                      "aggregation": "None"
                    }
                  },
                  {
                    "columnMatch": "AutomationId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "^(StreamingStatus|SnapshotStatus|Enabled)$",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "24ch",
                      "aggregation": "None"
                    }
                  },
                  {
                    "columnMatch": "Review",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "60ch",
                      "linkTarget": "CellDetails",
                      "aggregation": "None"
                    }
                  }
                ]
              }
            }
          },
          {
            "type": 3,
            "name": "ReadinessAutomationSources",
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type =~ 'microsoft.resources/subscriptions'\r\n| project subscriptionId = tolower(subscriptionId), Subscription = name, SubscriptionResourceId = id\r\n| join kind=leftouter (\r\n    resources\r\n    | where type =~ 'microsoft.security/automations'\r\n    | extend subscriptionId = tolower(subscriptionId), Automation = name, AutomationId = id, Location = location,\r\n        EnabledValue = tolower(tostring(properties.isEnabled)),\r\n        ScopeCount = array_length(properties.scopes), ActionCount = array_length(properties.actions), SourceCount = array_length(properties.sources)\r\n    | extend Enabled = case(EnabledValue == 'true', 'On', EnabledValue == 'false', 'Off', 'Unknown / not reported')\r\n    | extend SourceList = iff(coalesce(SourceCount, 0) > 0, properties.sources, dynamic([{}]))\r\n    | mv-expand Source = SourceList limit 2000\r\n    | extend EventSource = tostring(Source.eventSource), RuleSetCount = array_length(Source.ruleSets)\r\n    | extend RuleSetList = iff(coalesce(RuleSetCount, 0) > 0, Source.ruleSets, dynamic([{}])),\r\n        FilterState = case(isnull(Source.ruleSets) or RuleSetCount == 0, 'No rule sets reported', isnull(RuleSetCount), 'Invalid rule-set list / review', 'Filtered / review')\r\n    | mv-expand with_itemindex=RuleSetIndex RuleSet = RuleSetList limit 2000\r\n    | extend RuleCount = array_length(RuleSet.rules)\r\n    | extend RuleList = iff(coalesce(RuleCount, 0) > 0, RuleSet.rules, dynamic([{}]))\r\n    | mv-expand with_itemindex=RuleIndex Rule = RuleList limit 2000\r\n    | extend Frequency = case(EventSource in~ ('AssessmentsSnapshot', 'SubAssessmentsSnapshot', 'SecureScoresSnapshot', 'SecureScoreControlsSnapshot', 'RegulatoryComplianceAssessmentSnapshot', 'AttackPathsSnapshot'), 'Weekly snapshots', EventSource in~ ('Alerts', 'Assessments', 'SubAssessments', 'SecureScores', 'SecureScoreControls', 'RegulatoryComplianceAssessment', 'AttackPaths'), 'Streaming updates', 'Unknown / review'),\r\n        Property = tostring(Rule.propertyJPath), PropertyType = tostring(Rule.propertyType), Operator = tostring(Rule.operator), ExpectedValue = tostring(Rule.expectedValue),\r\n        Review = strcat(iff(isnull(SourceCount) or SourceCount == 0, 'Source list missing, empty or invalid; ', ''),\r\n            iff(SourceCount > 2000 or RuleSetCount > 2000 or RuleCount > 2000, 'List exceeds 2000: inventory incomplete; ', ''),\r\n            iff(isempty(EventSource), 'Event source not reported; ', ''),\r\n            iff(isnotnull(Source.ruleSets) and isnull(RuleSetCount), 'Invalid rule-set list; ', ''),\r\n            iff(RuleSetCount > 0 and (isnull(RuleCount) or RuleCount == 0), 'Rule set has missing, empty or invalid rules; ', ''),\r\n            iff(RuleCount > 0 and (isempty(tostring(Rule.propertyJPath)) or isempty(tostring(Rule.propertyType)) or isempty(tostring(Rule.operator)) or isnull(Rule.expectedValue)), 'Incomplete rule fields; ', ''))\r\n    | project subscriptionId, Automation, AutomationId, Enabled, EventSource, Frequency, FilterState, RuleSetIndex, RuleIndex, Property, PropertyType, Operator, ExpectedValue, Review\r\n) on subscriptionId\r\n| extend Automation = iff(isempty(AutomationId), 'Not observed', Automation), Enabled = iff(isempty(AutomationId), 'Not observed', Enabled)\r\n| extend Automation = case(Automation == 'Not observed', Automation, AutomationId matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(resourcegroups/[^/]+/)?providers/microsoft[.]security/automations/[^/]+/?$', AutomationId, strcat('Unresolved: ', Automation))\r\n| extend EventSource = iff(isempty(EventSource), 'Not reported', EventSource),\r\n    FilterState = iff(isempty(AutomationId), 'Not observed', FilterState),\r\n    Frequency = iff(isempty(AutomationId), 'Not observed', Frequency),\r\n    RuleSet = iff(FilterState == 'Filtered / review', tostring(RuleSetIndex + 1), ''),\r\n    RuleNumber = iff(isnotempty(Property) or isnotempty(Operator), tostring(RuleIndex + 1), ''),\r\n    Review = case(isempty(AutomationId), 'No visible automation; source settings not observed.', isempty(Review), 'None observed; configured source only, not delivery evidence.', Review)\r\n| project Subscription, SubscriptionResourceId, Automation, Enabled, EventSource, Frequency, FilterState, RuleSet, RuleNumber, Property, PropertyType, Operator, ExpectedValue, Review, AutomationId, subscriptionId\r\n| order by Subscription asc, Automation asc, EventSource asc, RuleSet asc, RuleNumber asc\r\n",
              "size": 0,
              "title": "Export data types, frequencies and filter rules",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "noDataMessage": "No selected subscriptions were returned. Check the subscription selection and Reader permissions.",
              "noDataMessageStyle": 2,
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "gridSettings": {
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "Enabled",
                    "label": "Automation enabled"
                  },
                  {
                    "columnId": "EventSource",
