          {
            "type": 12,
            "name": "SelectedControlRecommendations",
            "conditionalVisibility": {
              "parameterName": "SelectedControlScope",
              "comparison": "isNotEqualTo",
              "value": "{}"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "SelectedControlGuidance",
                  "content": {
                    "json": "### Recommendations mapped to the selected control\nSelect an individual control row above, not a subscription or standard group. Results are restricted to its subscription, standard and control, and to the current filters. A stale selection can return no results; select another control or clear the selection. Recommendation names open their Defender destination when a valid source-provided link is available. Resource counts are those reported for each mapped assessment, not unique resources across recommendations."
                  }
                },
                {
                  "type": 3,
                  "name": "SelectedControlCoverage",
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "securityresources\r\n| where type =~ 'microsoft.security/regulatorycompliancestandards/regulatorycompliancecontrols/regulatorycomplianceassessments'\r\n| extend Selection = parse_json(\"{SelectedControlScope:escapejson}\"), DrillScope = parse_json(\"{DetailScope:escapejson}\")\r\n| extend SelectedSubscription = tostring(Selection.subscriptionId), SelectedStandard = tostring(Selection.ComplianceStandard), SelectedControl = tostring(Selection.name)\r\n| where isempty(\"{ControlSearch:escapejson}\") or SelectedControl contains \"{ControlSearch:escapejson}\" or tostring(Selection.Description) contains \"{ControlSearch:escapejson}\"\r\n| where isnotempty(SelectedSubscription) and isnotempty(SelectedStandard) and isnotempty(SelectedControl)\r\n| where subscriptionId == SelectedSubscription\r\n| extend ComplianceStandard = extract('(?i)/regulatorycompliancestandards/([^/]+)/', 1, id), ControlName = extract('(?i)/regulatorycompliancecontrols/([^/]+)/', 1, id)\r\n| where ComplianceStandard == SelectedStandard and ControlName == SelectedControl\r\n| where \"{Control:escapejson}\" == '*' or ComplianceStandard == \"{Control:escapejson}\"\r\n| where isempty(tostring(DrillScope.subscriptionId)) or subscriptionId == tostring(DrillScope.subscriptionId)\r\n| where isempty(tostring(DrillScope.name)) or ComplianceStandard == tostring(DrillScope.name)\r\n| where '*' in ({DetailState}) or tostring(Selection.State) in ({DetailState})\r\n| summarize MappedAssessments = count()\r\n| extend Selection = parse_json(\"{SelectedControlScope:escapejson}\")\r\n| extend Coverage = case(isempty(tostring(Selection.subscriptionId)) or isempty(tostring(Selection.ComplianceStandard)) or isempty(tostring(Selection.name)), 'Select an individual control row',\r\n    MappedAssessments == 0, 'No matches in the current selection and filters',\r\n    MappedAssessments > 10000, 'Over 10,000 assessments / incomplete list',\r\n    'Within 10,000-assessment row budget')\r\n| extend SelectedSubscription = tostring(Selection.subscriptionId), SelectedStandard = tostring(Selection.ComplianceStandard), SelectedControl = tostring(Selection.name)\r\n| extend SubscriptionResource = iff(SelectedSubscription matches regex '(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', strcat('/subscriptions/', SelectedSubscription), '')\r\n| project SubscriptionResource, SelectedStandard, SelectedControl, MappedAssessments, Coverage",
                    "size": 0,
                    "title": "Selected control - mapped assessment count",
                    "queryType": 1,
                    "resourceType": "microsoft.resourcegraph/resources",
                    "crossComponentResources": [
                      "{Subscription}"
                    ],
                    "noDataMessage": "No count was returned. Check the selection, filters and Reader permissions.",
                    "noDataMessageStyle": 2,
                    "showExportToExcel": true,
                    "exportToExcelOptions": "all",
                    "gridSettings": {
                      "rowLimit": 10,
                      "labelSettings": [
                        {
                          "columnId": "SubscriptionResource",
                          "label": "Selected subscription"
                        },
                        {
                          "columnId": "SelectedStandard",
                          "label": "Selected standard"
                        },
                        {
                          "columnId": "SelectedControl",
                          "label": "Selected control"
                        },
                        {
                          "columnId": "MappedAssessments",
                          "label": "Mapped assessments"
                        },
                        {
                          "columnId": "Coverage",
                          "label": "Recommendation-list row budget"
                        }
                      ],
                      "formatters": [
                        {
                          "columnMatch": "SubscriptionResource",
                          "formatter": 13,
                          "formatOptions": {
                            "linkTarget": "Resource",
                            "showIcon": true,
                            "customColumnWidthSetting": "30ch"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "type": 3,
                  "name": "SelectedControlAssessmentList",
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "securityresources\r\n| where type =~ 'microsoft.security/regulatorycompliancestandards/regulatorycompliancecontrols/regulatorycomplianceassessments'\r\n| extend Selection = parse_json(\"{SelectedControlScope:escapejson}\"), DrillScope = parse_json(\"{DetailScope:escapejson}\")\r\n| extend SelectedSubscription = tostring(Selection.subscriptionId), SelectedStandard = tostring(Selection.ComplianceStandard), SelectedControl = tostring(Selection.name)\r\n| where isempty(\"{ControlSearch:escapejson}\") or SelectedControl contains \"{ControlSearch:escapejson}\" or tostring(Selection.Description) contains \"{ControlSearch:escapejson}\"\r\n| where isnotempty(SelectedSubscription) and isnotempty(SelectedStandard) and isnotempty(SelectedControl)\r\n| where subscriptionId == SelectedSubscription\r\n| extend ComplianceStandard = extract('(?i)/regulatorycompliancestandards/([^/]+)/', 1, id), ControlName = extract('(?i)/regulatorycompliancecontrols/([^/]+)/', 1, id)\r\n| where ComplianceStandard == SelectedStandard and ControlName == SelectedControl\r\n| where \"{Control:escapejson}\" == '*' or ComplianceStandard == \"{Control:escapejson}\"\r\n| where isempty(tostring(DrillScope.subscriptionId)) or subscriptionId == tostring(DrillScope.subscriptionId)\r\n| where isempty(tostring(DrillScope.name)) or ComplianceStandard == tostring(DrillScope.name)\r\n| where '*' in ({DetailState}) or tostring(Selection.State) in ({DetailState})\r\n| extend Recommendation = coalesce(tostring(properties.description), name), State = tostring(properties.state),\r\n    PassedResources = tolong(properties.passedResources), FailedResources = tolong(properties.failedResources), SkippedResources = tolong(properties.skippedResources),\r\n    SourceLink = tostring(properties.assessmentDetailsLink)\r\n| extend RecommendationLink = case(SourceLink matches regex '(?i)^https://portal[.]azure[.](com|us|cn)([/?#]|$)', SourceLink, SourceLink matches regex '(?i)^portal[.]azure[.](com|us|cn)([/?#]|$)', strcat('https://', SourceLink), '')\r\n| project Recommendation, State, FailedResources, PassedResources, SkippedResources, AssessmentKey = name, RecommendationLink\r\n| order by FailedResources desc, Recommendation asc",
                    "size": 0,
                    "title": "Recommendations for selected control",
                    "queryType": 1,
                    "resourceType": "microsoft.resourcegraph/resources",
                    "crossComponentResources": [
                      "{Subscription}"
                    ],
                    "noDataMessage": "No mapped assessments matched this control and the current filters. Select an individual control, check scope and Reader permissions, or clear the selection. An empty result is not proof of compliance.",
                    "noDataMessageStyle": 2,
                    "showExportToExcel": true,
                    "exportToExcelOptions": "all",
                    "gridSettings": {
                      "rowLimit": 10000,
                      "filter": true,
                      "formatters": [
                        {
                          "columnMatch": "Recommendation",
                          "formatter": 1,
                          "formatOptions": {
                            "linkTarget": "Url",
                            "linkColumn": "RecommendationLink",
                            "customColumnWidthSetting": "60ch",
                            "aggregation": "None"
                          }
                        },
                        {
                          "columnMatch": "^(AssessmentKey|RecommendationLink)$",
                          "formatter": 5
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Recommendation",
                          "label": "Recommendation (open Defender)"
                        },
                        {
                          "columnId": "State",
                          "label": "Assessment state"
                        },
                        {
                          "columnId": "FailedResources",
                          "label": "Failed resources"
                        },
                        {
                          "columnId": "PassedResources",
                          "label": "Passed resources"
                        },
                        {
                          "columnId": "SkippedResources",
                          "label": "Skipped resources"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "Detail"
      },
      "name": "RegulatoryComplianceDetail"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Regulatory Compliance Configuration"
            },
            "name": "ReadinessHeader"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "09dfa20e-9579-4c7b-8ec6-a161b013c321",
                  "version": "KqlParameterItem/1.0",
                  "name": "ShowSetupTips",
                  "label": "Setup tips",
                  "type": 10,
                  "description": "Show or hide setup instructions and Microsoft Learn links in every section. This control does not change Azure configuration.",
                  "isRequired": true,
                  "value": "On",
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[{\"value\":\"Off\",\"label\":\"Off\"},{\"value\":\"On\",\"label\":\"On\",\"selected\":true}]"
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "ReadinessSetupTipsToggle"
          },
          {
            "type": 1,
            "content": {
              "json": "Review configuration in order: **standards and reporting > Defender plans > continuous export > workspace history**. This read-only view uses the selected subscriptions; the top **Compliance standard** filter does not restrict this tab.\n\n**Observed is not the same as fully configured or protected.** Standards below are returned reporting results, not a complete assignment inventory. Plan settings do not prove installed agents or resource coverage. Export configuration does not prove delivery, query access or retention. Missing evidence can reflect access, scope or reporting delays. This view does not change settings, assign policies, create workspaces, install components or enable billable services."
            },
            "name": "ReadinessIntroduction"
          },
          {
            "type": 1,
            "content": {
              "json": "### 1. Standards rollout and reporting\nThe summary shows which subscriptions return standard results; the inventory names each reported standard. **These are reporting observations, not proof of every assigned standard.** Assigned standards without relevant assessed resources can be absent. Use Manage compliance policies to confirm assignments, including inherited scopes, and Compliance Detail to review control results.\n\nTo inspect a reported standard, choose its subscription and standard in **Compliance Detail scope** above, then use **Open selected standard in Compliance Detail** below. **Not observed** is not a selectable standard. The top compliance-standard filter remains in effect. The scope picker can show at most 1,000 subscription-standard options; narrow **Subscription** if a choice is missing."
            },
            "name": "ReadinessStandardsGuidance"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Setup instructions — standards\n1. In **Defender for Cloud > Regulatory compliance > Manage compliance policies**, select the subscription or applicable management group and open **Security policies**.\n2. Review the required standards, turn the relevant standard **On**, and supply its parameters. Review inherited assignments, exclusions and exemptions before changing scope; do not assume an absent reporting row means an unassigned standard.\n3. Confirm permissions and the plan prerequisites in the documentation, then allow time for assessment. A standard with no relevant assessed resources might not appear in reporting.\n\nMicrosoft Learn: [Assign regulatory compliance standards](https://learn.microsoft.com/en-us/azure/defender-for-cloud/assign-regulatory-compliance-standards) · [Understand standards and controls](https://learn.microsoft.com/en-us/azure/defender-for-cloud/concept-regulatory-compliance-standards)."
            },
            "conditionalVisibility": {
              "parameterName": "ShowSetupTips",
              "comparison": "isEqualTo",
              "value": "On"
            },
            "name": "ReadinessStandardsSetupTips"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type =~ 'microsoft.resources/subscriptions'\r\n| project subscriptionId, Subscription = name, SubscriptionResourceId = id\r\n| join kind=leftouter (\r\n    securityresources\r\n    | where type =~ 'microsoft.security/regulatorycompliancestandards'\r\n    | summarize Standards = count(), AssessedStandards = countif(toint(properties.passedControls) + toint(properties.failedControls) > 0) by subscriptionId\r\n) on subscriptionId\r\n| extend Standards = coalesce(Standards, 0), AssessedStandards = coalesce(AssessedStandards, 0)\r\n| extend Evidence = case(AssessedStandards > 0, 'Assessed results observed', Standards > 0, 'Standards observed; no assessed controls', 'Not observed / verify')\r\n| extend Recommendation = case(AssessedStandards > 0, 'Review relevant standards and their reporting scope.', Standards > 0, 'Check assessment coverage and allow time for results.', 'Verify read access, Defender for Cloud enablement and assigned standards.')\r\n| project Subscription, SubscriptionResourceId, subscriptionId, Evidence, Standards, AssessedStandards, Recommendation\r\n| order by Evidence asc, Subscription asc",
              "size": 0,
              "title": "Regulatory-compliance reporting by subscription",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "noDataMessage": "No selected subscriptions were returned. Check the subscription selection and Reader permissions.",
              "noDataMessageStyle": 2,
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "gridSettings": {
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  },
                  {
                    "columnId": "AssessedStandards",
                    "label": "Standards with assessed controls"
                  }
                ],
                "formatters": [
                  {
                    "columnMatch": "Subscription",
                    "formatter": 1,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkColumn": "SubscriptionResourceId"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionResourceId",
                    "formatter": 5
                  }
                ]
              }
            },
            "name": "ReadinessStandards"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type =~ 'microsoft.resources/subscriptions'\r\n| project subscriptionId = tolower(subscriptionId), Subscription = name, SubscriptionResourceId = id\r\n| join kind=leftouter (\r\n    securityresources\r\n    | where type =~ 'microsoft.security/regulatorycompliancestandards'\r\n    | extend subscriptionId = tolower(subscriptionId), Standard = name, Passed = tolong(properties.passedControls), Failed = tolong(properties.failedControls)\r\n    | extend AssessedControls = iff(isnotnull(Passed) and isnotnull(Failed) and Passed >= 0 and Failed >= 0, Passed + Failed, long(null))\r\n    | project subscriptionId, Standard, AssessedControls\r\n) on subscriptionId\r\n| extend Evidence = case(isempty(Standard), 'No standard results observed', isnull(AssessedControls), 'Incomplete counts / review', AssessedControls > 0, 'Assessed results observed', 'No assessed controls observed')\r\n| extend NextStep = case(isempty(Standard), 'Verify read access and assigned standards in Manage compliance policies; allow for assessment delays.', isnull(AssessedControls), 'Review this standard in Defender for Cloud; its assessed-control counts are incomplete.', AssessedControls > 0, 'Confirm the standard and assignment scope match your requirements; review control results in Compliance Detail.', 'Review relevant resources, assignment scope and assessment timing; no assessed controls were returned.')\r\n| extend Standard = iff(isempty(Standard), 'Not observed', Standard)\r\n| project Subscription, SubscriptionResourceId, subscriptionId, Standard, Evidence, AssessedControls, NextStep\r\n| order by Subscription asc, Standard asc",
              "size": 0,
              "title": "Reported standards by subscription",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "noDataMessage": "No selected subscriptions were returned. Check the subscription selection and Reader permissions.",
              "noDataMessageStyle": 2,
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "gridSettings": {
                "filter": true,
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Subscription",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "24ch",
                      "linkTarget": "Resource",
                      "linkColumn": "SubscriptionResourceId"
                    }
                  },
                  {
                    "columnMatch": "^(Standard|Plan)$",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "32ch"
                    }
                  },
                  {
                    "columnMatch": "^(Evidence|Configuration)$",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "28ch"
                    }
                  },
                  {
                    "columnMatch": "NextStep",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "65ch",
                      "linkTarget": "CellDetails"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionResourceId",
                    "formatter": 5
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  },
                  {
                    "columnId": "NextStep",
                    "label": "Recommended next step"
                  },
                  {
                    "columnId": "AssessedControls",
                    "label": "Assessed controls"
                  },
                  {
                    "columnId": "Standard",
                    "label": "Reported standard"
                  }
                ]
              }
            },
            "name": "ReadinessStandardInventory"
          },
          {
            "type": 11,
            "name": "ReadinessSelectedDetailAction",
            "conditionalVisibility": {
              "parameterName": "DetailScope",
              "comparison": "isNotEqualTo",
              "value": "{}"
            },
            "content": {
              "version": "LinkItem/1.0",
              "style": "toolbar",
              "links": [
                {
                  "id": "e29d4fe9-9370-4700-839b-b866e5bc5e57",
                  "cellValue": "selectedTab",
                  "linkTarget": "parameter",
                  "linkLabel": "Open selected standard in Compliance Detail",
                  "subTarget": "Detail",
                  "style": "link"
                }
              ]
            }
          },
          {
            "type": 1,
            "content": {
              "json": "### 2. CSPM levels, features and Defender plans\n**Foundational CSPM (free)** is the baseline; **Defender CSPM (paid)** adds advanced posture capabilities. The summary explicitly shows whether the paid plan is **Enabled** or **Disabled**. Missing or unrecognized evidence is **Not observed / verify**, not Disabled.\n\nThese are visible **subscription-level configuration settings**, not an installation, scanning or protection-health inventory. A paid plan or feature switch being enabled is not a compliance pass. Other Defender plans can provide overlapping capabilities; a disabled CSPM switch does not establish that a resource has no equivalent coverage. Review supported workloads, resource overrides, exclusions and actual findings separately."
            },
            "name": "ReadinessPlansGuidance"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Setup instructions - CSPM levels, feature settings and Defender plans\n**Choose the appropriate CSPM level.** [Foundational CSPM (free)](https://learn.microsoft.com/en-us/azure/defender-for-cloud/concept-cloud-security-posture-management) includes inventory, Microsoft Cloud Security Benchmark assessments, secure score and basic recommendations. **Defender CSPM (paid)** adds advanced posture capabilities such as attack paths, security explorer, risk prioritization, regulatory-compliance assessments and agentless insights. Foundational is not a failed configuration; select the level that meets your requirements. Workload threat-protection plans are separate.\n\n1. In **Defender for Cloud > Environment settings**, select the source subscription and open **Defender plans**. To enable the paid plan if required, set **Defender CSPM** to **On** and **Save**.\n2. Select **Settings** for Defender CSPM, review the applicable components below, select **Continue**, then **Save**. Use **Edit configuration** for machine-scanning exclusion tags. The workbook only reports settings; it never enables a plan or changes exclusions.\n3. Use a **Subscription Owner** to enable all features and required permissions. A user with fewer permissions can enable the paid plan without fully activating agentless scanning. Confirm supported clouds, regions, service tiers and workloads, onboarding permissions, resource-level overrides and actual results before considering coverage complete.\n4. Review [Defender for Cloud pricing](https://azure.microsoft.com/en-us/pricing/details/defender-for-cloud/), trial status, billable resource scope and possible supporting-service charges before enabling components. Sensitive-data discovery accesses customer data; review its permissions and scan scope. Do not enable every paid feature solely to make the dashboard look complete.\n\n| Monitored component | Why review it and what to configure |\n|---|---|\n| Agentless scanning for machines | Adds machine vulnerability, secret and software context. Review the switch, **Edit configuration** exclusion tags, required permissions and actual scan coverage. [Setup and exclusions](https://learn.microsoft.com/en-us/azure/defender-for-cloud/enable-agentless-scanning-vms). |\n| Kubernetes API access / agentless discovery | Supplies cluster configuration, identity and network context for attack paths. Review **Kubernetes API access** and supported clusters. [Agentless container setup](https://learn.microsoft.com/en-us/azure/defender-for-cloud/how-to-enable-agentless-containers). |\n| Registry access / image vulnerability assessment | Enables supported image vulnerability assessments. Review **Registry access**, registry permissions and actual findings; an enabled extension is not proof every image is assessed. [Registry and Kubernetes settings](https://learn.microsoft.com/en-us/azure/defender-for-cloud/how-to-enable-agentless-containers). |\n| Sensitive data discovery | Adds data-sensitivity context for risk prioritization. Review the switch, supported stores, data-access permissions and [data sensitivity configuration](https://learn.microsoft.com/en-us/azure/defender-for-cloud/data-sensitivity-settings). [Prerequisites, scope and costs](https://learn.microsoft.com/en-us/azure/defender-for-cloud/concept-data-security-posture-prepare). |\n| Identity and permissions (CIEM) | Identifies excessive and unused permissions. Review the CIEM switch, collection prerequisites and resulting recommendations. Existing Defender for Cloud CIEM is distinct from the retired standalone Entra Permissions Management product. [CIEM guidance](https://learn.microsoft.com/en-us/azure/defender-for-cloud/permissions-management). |\n| API security posture | Discovers and assesses supported APIs. Enable **API security posture management** when appropriate; review region, service tier and sensitive-data prerequisites. This is not the separate Defender for APIs workload-protection plan. [API setup and limitations](https://learn.microsoft.com/en-us/azure/defender-for-cloud/enable-api-security-posture). |\n| Serverless protection | Adds posture for supported Web Apps and Functions. Review the **Serverless protection** switch, eligibility, scan coverage and billing impact. [Serverless guidance](https://learn.microsoft.com/en-us/azure/defender-for-cloud/serverless-protection). |\n| Serverless containers | Adds posture for supported Container Apps and Container Instances, not runtime threat detection. Review **Serverless Containers** and **Registry access** for full features, cloud availability and charges. [Serverless container setup](https://learn.microsoft.com/en-us/azure/defender-for-cloud/posture-for-serverless-containers). |\n\n**Also verify in the portal:** actual scan/recommendation coverage, AI posture and other workload eligibility, connector permissions for AWS/GCP, data-sensitivity rules and resource overrides. Attack paths and security explorer are capabilities, not independently inferred On/Off switches here. Additional reported extensions remain visible; unsupported or portal-only settings require manual verification. Allow time for onboarding and data collection.\n\n**Other Defender plans:** compare each reported tier and subplan against the workload protection and regulatory prerequisites you need; review installation, sensor health, overrides and costs separately. **Standard** means the paid tier is enabled in the subscription pricing record; **Free** means that paid tier is disabled, not that every free capability or every resource is disabled.\n\nMicrosoft Learn: [Enable CSPM and components](https://learn.microsoft.com/en-us/azure/defender-for-cloud/tutorial-enable-cspm-plan) | [CSPM levels and capabilities](https://learn.microsoft.com/en-us/azure/defender-for-cloud/concept-cloud-security-posture-management) | [Plan/extension API fields and enforcement](https://learn.microsoft.com/en-us/azure/templates/microsoft.security/2024-01-01/pricings) | [Configure Defender plans](https://learn.microsoft.com/en-us/azure/defender-for-cloud/enable-enhanced-security) | [Coverage workbook](https://learn.microsoft.com/en-us/azure/defender-for-cloud/custom-dashboards-azure-workbooks#coverage-workbook)."
            },
            "conditionalVisibility": {
              "parameterName": "ShowSetupTips",
              "comparison": "isEqualTo",
              "value": "On"
            },
            "name": "ReadinessPlansSetupTips"
          },
          {
            "type": 3,
            "name": "ReadinessCspmSummary",
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type =~ 'microsoft.resources/subscriptions'\r\n| project subscriptionId = tolower(subscriptionId), Subscription = name, SubscriptionResourceId = id\r\n| join kind=leftouter (\r\n    securityresources\r\n    | where type =~ 'microsoft.security/pricings' and name =~ 'CloudPosture'\r\n    | where id =~ strcat('/subscriptions/', subscriptionId, '/providers/Microsoft.Security/pricings/', name)\r\n    | project subscriptionId = tolower(subscriptionId), PlanId = id, PricingTier = tostring(properties.pricingTier), Enforce = tostring(properties.enforce), ExtensionCount = array_length(properties.extensions)\r\n) on subscriptionId\r\n| extend DefenderCSPM = case(isempty(PlanId), 'Not observed / verify', PricingTier =~ 'Standard', 'Enabled (paid)', PricingTier =~ 'Free', 'Disabled', 'Unknown tier / review')\r\n| extend CSPMLevel = case(PricingTier =~ 'Standard', 'Defender CSPM + Foundational CSPM', PricingTier =~ 'Free', 'Foundational CSPM (free)', 'Not established / verify')\r\n| extend FoundationalCSPM = iff(PricingTier in~ ('Standard', 'Free'), 'Included (free)', 'Available free; verify onboarding')\r\n| extend Enforcement = case(Enforce =~ 'True', 'Enforced; overrides blocked', Enforce =~ 'False', 'Overrides allowed', 'Not reported / verify')\r\n| extend ExtensionInventory = case(isempty(PlanId), 'Plan not observed', isnull(ExtensionCount), 'Settings not reported / invalid', ExtensionCount > 1992, 'Too many settings / review', ExtensionCount == 0, 'No extension settings reported', 'Reported settings available')\r\n| extend NextStep = case(isempty(PlanId), 'Verify subscription read access, Defender for Cloud onboarding and the CloudPosture pricing record; absence does not prove disabled.', PricingTier =~ 'Free', 'Foundational CSPM is the free baseline. Decide whether advanced posture and regulatory-compliance capabilities justify Defender CSPM and its charges.', PricingTier =~ 'Standard', 'Review the feature switches and VM exclusions below, supported workloads and actual coverage. A paid plan being enabled does not prove scanning or protection.', 'Review the reported pricing tier in Environment settings; do not infer an enabled or disabled plan.')\r\n| extend PricingTier = iff(isempty(PricingTier), 'Not reported', PricingTier)\r\n| project Subscription, SubscriptionResourceId, subscriptionId, CSPMLevel, FoundationalCSPM, DefenderCSPM, PricingTier, Enforcement, ExtensionCount, ExtensionInventory, NextStep\r\n| order by Subscription asc",
              "size": 0,
              "title": "CSPM level and paid-plan enabled state by subscription",
