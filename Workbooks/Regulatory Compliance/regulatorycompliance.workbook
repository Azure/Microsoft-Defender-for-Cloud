                              {
                                "columnMatch": "ResourceLabel",
                                "formatter": 13,
                                "formatOptions": {
                                  "showIcon": true,
                                  "customColumnWidthSetting": "24ch",
                                  "aggregation": "None",
                                  "linkTarget": "Resource"
                                }
                              },
                              {
                                "columnMatch": "State",
                                "formatter": 18,
                                "formatOptions": {
                                  "aggregation": "None",
                                  "customColumnWidthSetting": "26ch",
                                  "thresholdsOptions": "icons",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Unhealthy",
                                      "representation": "3",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Healthy",
                                      "representation": "success",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "NotApplicable",
                                      "representation": "Unavailable",
                                      "text": "Not applicable"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Unknown",
                                      "representation": "Unavailable",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Unmapped",
                                      "representation": "warning",
                                      "text": "No resource assessment"
                                    },
                                    {
                                      "operator": "Default",
                                      "representation": "Blank",
                                      "text": ""
                                    }
                                  ]
                                }
                              },
                              {
                                "columnMatch": "^(Severity|ResourceType|ResourceGroup|ResourceSource)$",
                                "formatter": 1,
                                "formatOptions": {
                                  "aggregation": "None"
                                }
                              },
                              {
                                "columnMatch": "^(Workload|SubscriptionResourceId|ResourceKey|ResourceId|ResourceDisplay|AssessmentKey|RecommendationLink|StatusRank|SeverityRank)$",
                                "formatter": 5,
                                "formatOptions": {
                                  "aggregation": "None"
                                }
                              }
                            ],
                            "filter": true,
                            "sortBy": [
                              {
                                "itemKey": "StatusRank",
                                "sortOrder": 2
                              },
                              {
                                "itemKey": "SeverityRank",
                                "sortOrder": 2
                              }
                            ],
                            "labelSettings": [
