                      "customColumnWidthSetting": "12ch"
                    }
                  },
                  {
                    "columnMatch": "^(subscriptionId|FailureOrder)$",
                    "formatter": 5
                  }
                ],
                "hierarchySettings": {
                  "treeType": 1,
                  "groupBy": [
                    "subscriptionId",
                    "ComplianceStandard"
                  ],
                  "expandTopLevel": true
                },
                "sortBy": [
