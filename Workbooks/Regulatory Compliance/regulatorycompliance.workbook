          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type =~ 'microsoft.resources/subscriptions'\r\n| project subscriptionId = tolower(subscriptionId), Subscription = name, SubscriptionResourceId = id\r\n| join kind=leftouter (\r\n    securityresources\r\n    | where type =~ 'microsoft.security/pricings'\r\n    | where id =~ strcat('/subscriptions/', subscriptionId, '/providers/Microsoft.Security/pricings/', name)\r\n    | project subscriptionId = tolower(subscriptionId), Plan = name, PricingTier = tostring(properties.pricingTier), SubPlan = tostring(properties.subPlan)\r\n) on subscriptionId\r\n| extend Configuration = case(Plan =~ 'CloudPosture' and PricingTier =~ 'Standard', 'Defender CSPM enabled (paid)', Plan =~ 'CloudPosture' and PricingTier =~ 'Free', 'Defender CSPM disabled; Foundational free', isempty(Plan), 'Not observed / verify', PricingTier =~ 'Standard', 'Enabled (paid tier)', PricingTier =~ 'Free', 'Paid tier disabled (Free)', 'Unknown tier / review')\r\n| extend NextStep = case(isempty(Plan), 'Verify read access and review subscription Defender plan settings.', PricingTier =~ 'Standard', 'Review plan suitability, resource-level overrides, monitoring components and cost; configuration alone does not establish protection.', PricingTier =~ 'Free', 'Review whether the free capabilities meet your requirements; paid plans are an explicit cost decision.', 'Review the reported pricing tier in Defender for Cloud; no protection state is inferred.')\r\n| extend PlanId = iff(isempty(Plan), 'Not observed', Plan)\r\n| extend Plan = case(Plan =~ 'CloudPosture', 'Defender CSPM', Plan =~ 'VirtualMachines', 'Defender for Servers', Plan =~ 'StorageAccounts', 'Defender for Storage', Plan =~ 'AppServices', 'Defender for App Service', Plan =~ 'Containers', 'Defender for Containers', Plan =~ 'ContainerRegistry', 'Container registry (legacy plan)', Plan =~ 'KeyVaults', 'Defender for Key Vault', Plan =~ 'Arm', 'Defender for Resource Manager', Plan =~ 'Api', 'Defender for APIs', Plan =~ 'AI', 'Defender for AI', Plan)\r\n| extend Plan = iff(isempty(Plan), 'Not observed', Plan), PricingTier = iff(isempty(PricingTier), 'Not reported', PricingTier), SubPlan = iff(isempty(SubPlan), 'Not reported', SubPlan)\r\n| project Subscription, SubscriptionResourceId, subscriptionId, Plan, Configuration, PlanId, PricingTier, SubPlan, NextStep\r\n| order by Subscription asc, Plan asc",
              "size": 0,
              "title": "Observed subscription Defender plan settings",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "noDataMessage": "No selected subscriptions were returned. Check the subscription selection and Reader permissions.",
              "noDataMessageStyle": 2,
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "gridSettings": {
                "filter": true,
                "formatters": [
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Subscription",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "24ch",
                      "linkTarget": "Resource",
                      "linkColumn": "SubscriptionResourceId"
                    }
                  },
                  {
                    "columnMatch": "^(Standard|Plan)$",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "32ch"
                    }
                  },
                  {
                    "columnMatch": "^(Evidence|Configuration)$",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "43ch"
                    }
                  },
                  {
                    "columnMatch": "NextStep",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "65ch",
                      "linkTarget": "CellDetails"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionResourceId",
                    "formatter": 5
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  },
                  {
                    "columnId": "NextStep",
                    "label": "Recommended next step"
                  },
                  {
                    "columnId": "PricingTier",
                    "label": "Reported pricing tier"
                  },
                  {
                    "columnId": "SubPlan",
                    "label": "Reported subplan"
                  },
                  {
                    "columnId": "Configuration",
                    "label": "Paid-plan enabled state"
                  },
                  {
                    "columnId": "PlanId",
                    "label": "Reported plan ID"
                  }
                ],
                "rowLimit": 10000
              }
            },
            "name": "ReadinessDefenderPlans"
          },
          {
            "type": 1,
            "content": {
              "json": "### 3. Continuous export configuration\nEach row compares one setting with its recommended value for a subscription and destination workspace: **✅ Matches**, **❌ Does not match**, or a neutral marker when the value is not observed or unknown (never treated as Off). The goal is subscription-wide, unfiltered Regulatory compliance streaming and snapshots to **the same valid Log Analytics workspace**. A match is configuration evidence only and does not establish data delivery. Event Hub-only destinations do not meet this workbook's Log Analytics requirement. Narrow the subscription selection if Resource Graph reports a result limit."
            },
            "name": "ReadinessConfigurationGuidance"
          },
          {
            "type": 1,
            "content": {
              "json": "#### Setup instructions — continuous export\n1. In **Defender for Cloud > Environment settings**, select the source subscription and open **Continuous export > Log Analytics workspace**.\n2. Export **Regulatory compliance** with both **Streaming updates** and **Snapshots** to the **same workspace**. Review enabled status, subscription-wide scope and source filters against the setting checks below.\n3. Verify destination permissions before saving configuration. A central destination can be in another subscription; a ✅ match is not proof that data has arrived.\n\nMicrosoft Learn: [Continuous export setup and permissions](https://learn.microsoft.com/en-us/azure/defender-for-cloud/continuous-export) · [Configure continuous export at scale with Azure Policy](https://learn.microsoft.com/en-us/azure/defender-for-cloud/continuous-export-azure-policy).\n\nInspect the detailed switches, scopes, destinations and source-filter tables below. API field reference: [Security automation settings, sources, actions and rules](https://learn.microsoft.com/en-us/azure/templates/microsoft.security/2023-12-01-preview/automations)."
            },
            "name": "ReadinessNextSteps",
            "conditionalVisibility": {
              "parameterName": "ShowSetupTips",
              "comparison": "isEqualTo",
              "value": "On"
            }
          },
          {
            "type": 1,
            "name": "ReadinessExportSettingChecksTips",
            "content": {
              "json": "#### Setup tips — what each setting check means\nThe table below lists one row per setting for each subscription and destination workspace. **✅ Matches** means the observed value equals the recommended value; **❌ Does not match** means it is observed and differs; the neutral marker means the value is not observed or unknown, which is **not** the same as Off.\n\n| Setting | Recommended | What it checks and why |\n|---|---|---|\n| Streaming updates | On | An enabled automation exporting the **Regulatory compliance assessment** data type. It sends each assessment change as it happens, so Compliance Over Time can show when a control changed state. |\n| Snapshots | On | An enabled automation exporting **Regulatory compliance assessment snapshots**: weekly point-in-time records for selected data. Snapshots do not by themselves prove complete coverage or delivery. |\n| Export scope | Whole subscription | All reported scope paths cover the whole subscription. An explicitly empty scope array or a known valid narrower scope is a mismatch. Missing, malformed or oversized scope evidence stays Unknown unless a known enabled scope mismatch takes precedence. |\n| Source filters | None (all data) | Missing, null or empty-array rule sets mean no filters. Nonempty arrays confirm filters that can omit data; other non-array values stay Unknown. A known enabled filtered regulatory source takes precedence over uncertain siblings. |\n| Destination workspace | Valid Log Analytics workspace | The action is a Log Analytics workspace with a well-formed resource ID. Event Hub or Logic App destinations do not feed the Compliance Over Time workbook. |\n| Same workspace for both | Both target this workspace | Checks configured target alignment for streaming and snapshots, not whether either export is enabled or data was delivered. One observed type with incomplete missing-type evidence stays Unknown. |\n| Configuration list size | Complete | Scopes, actions and sources are each read up to 2,000 entries; larger or invalid lists make the check incomplete. |\n\nA green check is **configuration evidence only**. It does not prove data has arrived, that you can read the workspace, or what retention and ingestion will cost. Change a setting in **Defender for Cloud > Environment settings > Continuous export**; see [Continuous export](https://learn.microsoft.com/en-us/azure/defender-for-cloud/continuous-export) and [Configure at scale with Azure Policy](https://learn.microsoft.com/en-us/azure/defender-for-cloud/continuous-export-azure-policy)."
            },
            "conditionalVisibility": {
              "parameterName": "ShowSetupTips",
              "comparison": "isEqualTo",
              "value": "On"
            }
          },
          {
            "type": 3,
            "name": "ReadinessExportSettingChecks",
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type =~ 'microsoft.resources/subscriptions'\r\n| project subscriptionId = tolower(subscriptionId), Subscription = name, SubscriptionResourceId = id\r\n| join kind=leftouter (\r\n    resources\r\n    | where type =~ 'microsoft.security/automations'\r\n    | extend subscriptionId = tolower(subscriptionId), AutomationId = id, Enabled = tolower(tostring(properties.isEnabled))\r\n    | extend ScopeCount = array_length(properties.scopes), ActionCount = array_length(properties.actions), SourceCount = array_length(properties.sources)\r\n    | extend ScopeList = iff(isnull(ScopeCount) or ScopeCount == 0 or ScopeCount > 2000, dynamic([{}]), properties.scopes),\r\n        SourceList = iff(isnull(SourceCount) or SourceCount == 0 or SourceCount > 2000, dynamic([{}]), properties.sources),\r\n        ActionList = iff(isnull(ActionCount) or ActionCount == 0 or ActionCount > 2000, dynamic([{}]), properties.actions)\r\n    | mv-expand Scope = ScopeList, Source = SourceList, InventoryAction = ActionList limit 2000\r\n    | extend ScopePath = trim_end('/+', tolower(tostring(Scope.scopePath))), EventSource = tolower(tostring(Source.eventSource))\r\n    | extend ValidScope = ScopePath matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/resourcegroups/[^/]+(/providers/[^/]+(/[^/]+/[^/]+)+)?|/providers/[^/]+(/[^/]+/[^/]+)+)?/?$',\r\n        RuleSetCount = array_length(Source.ruleSets)\r\n    | summarize Actions = any(ActionList),\r\n        WholeScopes = countif(ScopePath == strcat('/subscriptions/', subscriptionId)),\r\n        NarrowScopes = countif(ValidScope and ScopePath != strcat('/subscriptions/', subscriptionId)),\r\n        ReportedScopes = countif(ValidScope), ReportedSources = countif(isnotempty(EventSource)),\r\n        ReportedActions = countif(tostring(InventoryAction.actionType) in~ ('Workspace', 'EventHub', 'LogicApp')),\r\n        StreamingSources = countif(EventSource == 'regulatorycomplianceassessment'),\r\n        StreamingFiltered = countif(EventSource == 'regulatorycomplianceassessment' and RuleSetCount > 0),\r\n        SnapshotSources = countif(EventSource == 'regulatorycomplianceassessmentsnapshot'),\r\n        SnapshotFiltered = countif(EventSource == 'regulatorycomplianceassessmentsnapshot' and RuleSetCount > 0),\r\n        RegulatoryFilterUnknown = countif(EventSource in ('regulatorycomplianceassessment', 'regulatorycomplianceassessmentsnapshot') and isnotnull(Source.ruleSets) and isnull(RuleSetCount))\r\n      by subscriptionId, AutomationId, Enabled, ScopeCount, ActionCount, SourceCount\r\n    | extend SourceInventoryComplete = isnotnull(SourceCount) and SourceCount <= 2000 and ReportedSources == SourceCount,\r\n        ScopeInventoryComplete = isnotnull(ScopeCount) and ScopeCount <= 2000 and ReportedScopes == ScopeCount,\r\n        FullScope = coalesce(ScopeCount > 0 and WholeScopes == ScopeCount, false)\r\n    | extend ListsComplete = ScopeInventoryComplete and isnotnull(ActionCount) and ActionCount <= 2000 and ReportedActions == ActionCount and SourceInventoryComplete\r\n    | mv-expand Action = Actions limit 2000\r\n    | extend ActionType = tostring(Action.actionType)\r\n    | extend Workspace = iff(ActionType =~ 'Workspace', trim_end('/+', tolower(tostring(Action.workspaceResourceId))), ''),\r\n        ListsComplete = ListsComplete and ActionType in~ ('Workspace', 'EventHub', 'LogicApp')\r\n    | where ActionType =~ 'Workspace' or not(ListsComplete)\r\n    | extend ValidWorkspace = Workspace matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/resourcegroups/[^/]+/providers/microsoft[.]operationalinsights/workspaces/[^/]+/?$'\r\n    | summarize ConfigurationRows = count(),\r\n        StreamingOn = countif(StreamingSources > 0 and Enabled == 'true'),\r\n        StreamingDisabled = countif(StreamingSources > 0 and Enabled == 'false'),\r\n        StreamingUnknown = countif((StreamingSources > 0 and Enabled !in ('true', 'false')) or not(SourceInventoryComplete)),\r\n        SnapshotOn = countif(SnapshotSources > 0 and Enabled == 'true'),\r\n        SnapshotDisabled = countif(SnapshotSources > 0 and Enabled == 'false'),\r\n        SnapshotUnknown = countif((SnapshotSources > 0 and Enabled !in ('true', 'false')) or not(SourceInventoryComplete)),\r\n        StreamingRows = countif(StreamingSources > 0), SnapshotRows = countif(SnapshotSources > 0),\r\n        ScopeIssues = countif(Enabled == 'true' and (StreamingSources > 0 or SnapshotSources > 0) and (ScopeCount == 0 or NarrowScopes > 0)),\r\n        ScopeUnknown = countif(Enabled != 'false' and (not(SourceInventoryComplete) or ((StreamingSources > 0 or SnapshotSources > 0) and (not(ScopeInventoryComplete) or (Enabled != 'true' and not(FullScope)))))),\r\n        FilterIssues = countif(Enabled == 'true' and (StreamingFiltered > 0 or SnapshotFiltered > 0)),\r\n        FilterUnknown = countif(Enabled != 'false' and (not(SourceInventoryComplete) or RegulatoryFilterUnknown > 0 or (Enabled != 'true' and (StreamingFiltered > 0 or SnapshotFiltered > 0)))),\r\n        DestinationIssues = countif(not(ValidWorkspace)),\r\n        ExpansionIssues = countif(not(ListsComplete))\r\n      by subscriptionId, Workspace\r\n) on subscriptionId\r\n| extend ConfigurationRows = coalesce(ConfigurationRows, 0), StreamingOn = coalesce(StreamingOn, 0), StreamingDisabled = coalesce(StreamingDisabled, 0), StreamingUnknown = coalesce(StreamingUnknown, 0), SnapshotOn = coalesce(SnapshotOn, 0), SnapshotDisabled = coalesce(SnapshotDisabled, 0), SnapshotUnknown = coalesce(SnapshotUnknown, 0), StreamingRows = coalesce(StreamingRows, 0), SnapshotRows = coalesce(SnapshotRows, 0), ScopeIssues = coalesce(ScopeIssues, 0), ScopeUnknown = coalesce(ScopeUnknown, 0), FilterIssues = coalesce(FilterIssues, 0), FilterUnknown = coalesce(FilterUnknown, 0), DestinationIssues = coalesce(DestinationIssues, 0), ExpansionIssues = coalesce(ExpansionIssues, 0)\r\n| extend AnyOn = StreamingOn + SnapshotOn > 0\r\n| extend Checks = iff(ConfigurationRows == 0, dynamic([0]), dynamic([1, 2, 3, 4, 5, 6, 7]))\r\n| mv-expand Check = Checks to typeof(long) limit 7\r\n| extend Setting = case(Check == 0, 'Regulatory compliance continuous export', Check == 1, 'Streaming updates', Check == 2, 'Snapshots', Check == 3, 'Export scope', Check == 4, 'Source filters', Check == 5, 'Destination workspace', Check == 6, 'Same workspace for both', 'Configuration list size')\r\n| extend Observed = case(\r\n    Check == 0, 'Not observed',\r\n    Check == 1, case(StreamingOn > 0, 'On', StreamingUnknown > 0, 'Unknown', StreamingDisabled > 0, 'Off', 'Not configured'),\r\n    Check == 2, case(SnapshotOn > 0, 'On', SnapshotUnknown > 0, 'Unknown', SnapshotDisabled > 0, 'Off', 'Not configured'),\r\n    Check == 3, case(ScopeIssues > 0, 'Narrower or unreported scope', ScopeUnknown > 0, 'Unknown', not(AnyOn), 'Not observed (no confirmed enabled export)', 'Whole subscription'),\r\n    Check == 4, case(FilterIssues > 0, 'Filtered', FilterUnknown > 0, 'Unknown', not(AnyOn), 'Not observed (no confirmed enabled export)', 'None (all data)'),\r\n    Check == 5, case(not(AnyOn), 'Not observed (no confirmed enabled export)', DestinationIssues > 0, 'Not a valid Log Analytics workspace ID', 'Valid Log Analytics workspace'),\r\n    Check == 6, case(DestinationIssues > 0, 'Invalid or unreported workspace', StreamingRows > 0 and SnapshotRows > 0, 'Both target this workspace', StreamingRows > 0, iff(SnapshotUnknown > 0, 'Unknown', 'Streaming only'), SnapshotRows > 0, iff(StreamingUnknown > 0, 'Unknown', 'Snapshots only'), 'Not observed'),\r\n    case(ExpansionIssues > 0, 'Large or invalid lists: incomplete', not(AnyOn), 'Not observed (no confirmed enabled export)', 'Complete'))\r\n| extend Recommended = case(Check == 0, 'Export configured', Check in (1, 2), 'On', Check == 3, 'Whole subscription', Check == 4, 'None (all data)', Check == 5, 'Valid Log Analytics workspace', Check == 6, 'Both target this workspace', 'Complete')\r\n| extend Result = case(Observed startswith 'Not observed' or Observed == 'Unknown', 'Not observed', Observed == Recommended, 'Matches', 'Does not match')\r\n| extend Workspace = case(ConfigurationRows == 0, 'No workspace observed', isempty(Workspace), 'Workspace ID missing', Workspace)\r\n| extend WorkspaceResource = iff(Workspace matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/resourcegroups/[^/]+/providers/microsoft[.]operationalinsights/workspaces/[^/]+/?$', Workspace, '')\r\n| project Subscription, SubscriptionResourceId, Workspace, WorkspaceResource, Setting, Observed, Recommended, Result, Check\r\n| order by Subscription asc, Workspace asc, Check asc\r\n| project-away Check",
              "size": 0,
              "title": "Continuous-export settings checked against recommended values",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "noDataMessage": "No selected subscriptions were returned. Check the subscription selection and Reader permissions.",
              "noDataMessageStyle": 2,
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "gridSettings": {
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "Workspace",
                    "label": "Destination workspace"
                  },
                  {
                    "columnId": "WorkspaceResource",
                    "label": "Open workspace"
                  },
                  {
                    "columnId": "Observed",
                    "label": "Observed value"
                  },
                  {
                    "columnId": "Recommended",
                    "label": "Recommended value"
                  },
                  {
                    "columnId": "Result",
                    "label": "Matches recommendation?"
                  }
                ],
                "formatters": [
                  {
                    "columnMatch": "Subscription",
                    "formatter": 1,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkColumn": "SubscriptionResourceId"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionResourceId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "WorkspaceResource",
                    "formatter": 13,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "showIcon": true,
                      "customColumnWidthSetting": "24ch",
                      "aggregation": "None"
                    }
                  },
                  {
                    "columnMatch": "Workspace",
                    "formatter": 1,
                    "formatOptions": {
