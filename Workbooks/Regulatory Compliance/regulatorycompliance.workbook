                            }
                          ]
                        }
                      },
                      {
                        "type": 3,
                        "name": "WorkloadSelectedResourceCoverage",
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "securityresources\r\n| where type =~ 'microsoft.security/regulatorycompliancestandards/regulatorycompliancecontrols/regulatorycomplianceassessments'\r\n| where subscriptionId == \"{WorkloadDetailSubscription:id}\"\r\n| where subscriptionId in~ ({Subscription:subid})\r\n| extend SelectedResource = parse_json(\"{WorkloadResourceScope:escapejson}\")\r\n| where isnotempty(tostring(SelectedResource.ResourceKey)) and subscriptionId == tostring(SelectedResource.subscriptionId)\r\n| extend ComplianceStandard = extract('(?i)/regulatorycompliancestandards/([^/]+)/', 1, id)\r\n| where \"{Control:escapejson}\" == '*' or ComplianceStandard == \"{Control:escapejson}\"\r\n| project subscriptionId, AssessmentKey = name, MappedRecommendation = tostring(properties.description), MappedLink = tostring(properties.assessmentDetailsLink)\r\n| summarize MappedRecommendation = any(MappedRecommendation), MappedLink = any(MappedLink) by subscriptionId, AssessmentKey\r\n| join kind=leftouter (\r\n    securityresources\r\n    | where type =~ 'microsoft.security/assessments'\r\n    | where subscriptionId == \"{WorkloadDetailSubscription:id}\"\r\n    | where subscriptionId in~ ({Subscription:subid})\r\n    | extend SelectedResource = parse_json(\"{WorkloadResourceScope:escapejson}\")\r\n    | where isnotempty(tostring(SelectedResource.ResourceKey)) and subscriptionId == tostring(SelectedResource.subscriptionId)\r\n    | extend Source = tolower(tostring(properties.resourceDetails.Source))\r\n    | project subscriptionId, AssessmentKey = name, AssessmentId = id, Source, NativeResourceId = case(Source in ('aws', 'gcp') and isnotempty(tostring(properties.resourceDetails.ConnectorId)) and isnotempty(tostring(properties.resourceDetails.Id)), tostring(properties.resourceDetails.Id), Source == 'aws', tostring(properties.resourceDetails.AwsResourceId), Source == 'gcp', tostring(properties.resourceDetails.GcpResourceId), tostring(properties.resourceDetails.Id)), NativeResourceType = tostring(properties.resourceDetails.ResourceType), AssessmentResourceGroup = resourceGroup, AssessmentRecommendation = tostring(properties.displayName), StatusCode = tostring(properties.status.code), AssessmentSeverity = tostring(properties.metadata.severity), AssessmentLink = tostring(properties.links.azurePortal)\r\n) on subscriptionId, AssessmentKey\r\n| extend ResourceId = case(isnotempty(NativeResourceId), NativeResourceId, isempty(Source) or Source == 'azure', extract('(?i)^(.+)/providers/microsoft.security/assessments/[^/]+$', 1, AssessmentId), '')\r\n| extend ResourceSource = case(isempty(AssessmentId), 'unmapped', isnotempty(Source), Source, ResourceId startswith '/subscriptions/', 'azure', 'unknown'), NormalizedId = tolower(ResourceId)\r\n| extend ProviderPath = tostring(split(NormalizedId, '/providers/')[-1])\r\n| extend ResourceType = case(NormalizedId startswith '/subscriptions/' and ProviderPath != NormalizedId, strcat(tostring(split(ProviderPath, '/')[0]), '/', strcat_array(extract_all(@'/([^/]+)/[^/]+', ProviderPath), '/')), NormalizedId matches regex '^/subscriptions/[^/]+$', 'microsoft.resources/subscriptions', isnotempty(NativeResourceType), NativeResourceType, 'Unmapped')\r\n| extend ResourceGroup = iff(ResourceSource == 'azure', extract('(?i)/resourcegroups/([^/]+)', 1, ResourceId), AssessmentResourceGroup), ResourceKey = case(isempty(AssessmentId), 'No resource assessment', isempty(ResourceId), strcat('Resource identity unavailable: ', AssessmentId), ResourceSource == 'azure', NormalizedId, strcat(ResourceSource, ':', ResourceId))\r\n| extend Workload = case(isempty(ResourceId), 'Other/unmapped', ResourceType =~ 'microsoft.resources/subscriptions', 'Subscription-level', ResourceType startswith 'microsoft.compute/' or ResourceType startswith 'microsoft.hybridcompute/', 'Compute', ResourceType startswith 'microsoft.containerservice/' or ResourceType startswith 'microsoft.containerregistry/' or ResourceType startswith 'microsoft.kubernetes/' or ResourceType startswith 'microsoft.app/containerapps' or ResourceType startswith 'microsoft.app/managedenvironments', 'Containers', ResourceType startswith 'microsoft.sql/' or ResourceType startswith 'microsoft.sqlvirtualmachine/' or ResourceType startswith 'microsoft.dbforpostgresql/' or ResourceType startswith 'microsoft.dbformysql/' or ResourceType startswith 'microsoft.dbformariadb/' or ResourceType startswith 'microsoft.documentdb/' or ResourceType startswith 'microsoft.cache/', 'Databases', ResourceType startswith 'microsoft.storage/', 'Storage', ResourceType startswith 'microsoft.keyvault/', 'Key Vault', ResourceType startswith 'microsoft.network/', 'Networking', ResourceType startswith 'microsoft.web/', 'App Services', 'Other/unmapped')\r\n| extend State = case(isempty(AssessmentId), 'Unmapped', StatusCode =~ 'Unhealthy', 'Unhealthy', StatusCode =~ 'Healthy', 'Healthy', StatusCode =~ 'NotApplicable', 'NotApplicable', 'Unknown'), Severity = case(AssessmentSeverity =~ 'High', 'High', AssessmentSeverity =~ 'Medium', 'Medium', AssessmentSeverity =~ 'Low', 'Low', 'Unknown'), Recommendation = coalesce(AssessmentRecommendation, MappedRecommendation, AssessmentKey), RecommendationLink = case(AssessmentLink matches regex '(?i)^https://portal[.]azure[.](com|us|cn)([/?#]|$)', AssessmentLink, AssessmentLink matches regex '(?i)^portal[.]azure[.](com|us|cn)([/?#]|$)', strcat('https://', AssessmentLink), MappedLink matches regex '(?i)^https://portal[.]azure[.](com|us|cn)([/?#]|$)', MappedLink, MappedLink matches regex '(?i)^portal[.]azure[.](com|us|cn)([/?#]|$)', strcat('https://', MappedLink), ''), ResourceDisplay = case(isempty(AssessmentId), 'No resource assessment', isempty(ResourceId), 'Resource identity unavailable', ResourceId)\r\n| extend StatusRank = case(State == 'Unhealthy', 4, State == 'Unknown', 3, State == 'Unmapped', 2, State == 'NotApplicable', 1, 0), SeverityRank = case(Severity == 'High', 3, Severity == 'Medium', 2, Severity == 'Low', 1, 0)\r\n| extend RowRank = StatusRank * 10 + SeverityRank\r\n| project Workload, subscriptionId, ResourceKey, AssessmentKey, ResourceId, ResourceDisplay, ResourceType, ResourceGroup, ResourceSource, Recommendation, State, Severity, RecommendationLink, AssessmentId, StatusRank, SeverityRank, RowRank\r\n| summarize arg_max(RowRank, *) by subscriptionId, ResourceKey, AssessmentKey\r\n| where '*' in ({Workload}) or Workload in ({Workload})\r\n| where '*' in ({WorkloadState}) or State in ({WorkloadState})\r\n| where isempty(\"{WorkloadResourceSearch:escapejson}\") or ResourceDisplay contains \"{WorkloadResourceSearch:escapejson}\" or ResourceGroup contains \"{WorkloadResourceSearch:escapejson}\" or ResourceType contains \"{WorkloadResourceSearch:escapejson}\"\r\n| extend SelectedResource = parse_json(\"{WorkloadResourceScope:escapejson}\")\r\n| where isnotempty(tostring(SelectedResource.ResourceKey)) and subscriptionId == tostring(SelectedResource.subscriptionId) and ResourceKey == tostring(SelectedResource.ResourceKey) and Workload == tostring(SelectedResource.Workload)\r\n| summarize MatchingRecommendations = count(), Resource = any(ResourceDisplay), FailedFindings = countif(State == 'Unhealthy')\r\n| extend Selection = parse_json(\"{WorkloadResourceScope:escapejson}\")\r\n| extend Coverage = case(isempty(tostring(Selection.ResourceKey)), 'Select a resource row, not a group',\r\n    MatchingRecommendations == 0, 'Selection has no matches in the current filters',\r\n    MatchingRecommendations > 10000, 'Over 10,000 recommendations / incomplete detail',\r\n    'Within 10,000-recommendation row budget'),\r\n    NextStep = case(isempty(tostring(Selection.ResourceKey)), 'Select an individual resource row in the resource list.',\r\n        MatchingRecommendations == 0, 'Select another resource or clear selection; current filters may exclude this resource.',\r\n        MatchingRecommendations > 10000, 'Narrow Compliance standard or Resource detail state. Export contains returned rows only.',\r\n        'Review the returned recommendations and their Defender links. Source permissions and query limits still apply.')\r\n| project Resource, MatchingRecommendations, FailedFindings, Coverage, NextStep",
