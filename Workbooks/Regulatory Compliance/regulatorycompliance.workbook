                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let SelectedSubscriptions = datatable(SourceSubscription:string)[{Subscription:subid}]\r\n| extend SourceSubscription = tolower(SourceSubscription);\r\nlet HistoryRows = SecurityRegulatoryCompliance\r\n| where TimeGenerated >= ago(90d)\r\n| extend SourceSubscription = tolower(tostring(RegulatoryComplianceSubscriptionId)), Standard = tostring(ComplianceStandard), ControlId = tostring(ComplianceControl)\r\n| join kind=inner (SelectedSubscriptions) on SourceSubscription\r\n\r\n| where \"{HistoryStandard:escapejson}\" == '*' or Standard == \"{HistoryStandard:escapejson}\"\r\n| extend SnapshotDay = startofday(TimeGenerated);\r\nlet SnapshotRows = HistoryRows\r\n| where IsSnapshot == true and isnotempty(Standard);\r\nlet SnapshotDays = SnapshotRows\r\n| summarize LastRecord = max(TimeGenerated), IncompleteRecords = countif(isempty(ControlId) or isempty(RecommendationId)) by SourceSubscription, Standard, SnapshotDay;\r\nlet ControlDays = SnapshotRows\r\n| where isnotempty(ControlId)\r\n| extend StateRank = case(State =~ 'Failed', 6, isempty(RecommendationId), 5, State =~ 'Passed', 4, State =~ 'Skipped', 3, State =~ 'NotApplicable' or State =~ 'Not applicable', 2, State =~ 'Unsupported', 1, 5)\r\n| summarize StateRank = max(StateRank) by SourceSubscription, Standard, SnapshotDay, ControlId, RecommendationId, AssessedResourceId, TimeGenerated\r\n| summarize arg_max(TimeGenerated, StateRank) by SourceSubscription, Standard, SnapshotDay, ControlId, RecommendationId, AssessedResourceId\r\n| summarize StateRank = max(StateRank) by SourceSubscription, Standard, SnapshotDay, ControlId\r\n| extend ControlState = case(StateRank == 6, 'Failed', StateRank == 5, 'Unknown', StateRank == 4, 'Passed', StateRank == 3, 'Skipped', StateRank == 2, 'Not applicable', 'Unsupported');\r\nlet DayPosture = SnapshotDays\r\n| join kind=leftouter (\r\n    ControlDays\r\n    | summarize Passed = countif(ControlState == 'Passed'), Failed = countif(ControlState == 'Failed'), Other = countif(ControlState !in ('Passed', 'Failed')) by SourceSubscription, Standard, SnapshotDay\r\n) on SourceSubscription, Standard, SnapshotDay\r\n| extend Passed = coalesce(Passed, 0), Failed = coalesce(Failed, 0), Other = coalesce(Other, 0)\r\n| extend Assessed = Passed + Failed\r\n| extend PassPercent = iff(Assessed > 0 and IncompleteRecords == 0, 100.0 * Passed / Assessed, real(null));\r\nlet LatestDays = SnapshotDays\r\n| summarize LatestDay = max(SnapshotDay) by SourceSubscription, Standard;\r\nlet PairDays = SnapshotDays\r\n| join kind=inner (LatestDays) on SourceSubscription, Standard\r\n| summarize LatestDay = max(LatestDay), PreviousDay = maxif(SnapshotDay, SnapshotDay < LatestDay), ObservedDays = count() by SourceSubscription, Standard;\r\nlet CurrentControls = ControlDays\r\n| join kind=inner (PairDays | where isnotnull(PreviousDay)) on SourceSubscription, Standard\r\n| where SnapshotDay == LatestDay\r\n| project SourceSubscription, Standard, ControlId, CurrentState = ControlState;\r\nlet PreviousControls = ControlDays\r\n| join kind=inner (PairDays | where isnotnull(PreviousDay)) on SourceSubscription, Standard\r\n| where SnapshotDay == PreviousDay\r\n| project PreviousSubscription = SourceSubscription, PreviousStandard = Standard, PreviousControl = ControlId, PreviousState = ControlState;\r\nlet ControlComparison = CurrentControls\r\n| join kind=fullouter (PreviousControls) on $left.SourceSubscription == $right.PreviousSubscription, $left.Standard == $right.PreviousStandard, $left.ControlId == $right.PreviousControl\r\n| extend SourceSubscription = coalesce(SourceSubscription, PreviousSubscription), Standard = coalesce(Standard, PreviousStandard), ControlId = coalesce(ControlId, PreviousControl)\r\n| extend Comparable = CurrentState in ('Passed', 'Failed') and PreviousState in ('Passed', 'Failed')\r\n| extend Change = case(isempty(CurrentState), 'Not observed in latest snapshot', isempty(PreviousState), 'Newly observed control', CurrentState == PreviousState, 'Unchanged', CurrentState == 'Failed', 'Became failed', PreviousState == 'Failed' and CurrentState == 'Passed', 'Recovered to passed', 'Other state change');\r\nControlComparison\r\n| where Change != 'Unchanged'\r\n| join kind=inner (PairDays) on SourceSubscription, Standard\r\n| project SourceSubscription, Standard, ControlId, Change, PreviousState = iff(isempty(PreviousState), 'Not observed', PreviousState), CurrentState = iff(isempty(CurrentState), 'Not observed', CurrentState), PreviousDay = format_datetime(PreviousDay, 'yyyy-MM-dd'), LatestDay = format_datetime(LatestDay, 'yyyy-MM-dd')\r\n| order by Change asc, Standard asc, SourceSubscription asc, ControlId asc",
