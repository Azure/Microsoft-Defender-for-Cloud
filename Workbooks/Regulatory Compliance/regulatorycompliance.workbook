          {
            "type": 3,
            "name": "ReadinessAutomationDestinations",
            "content": {
              "version": "KqlItem/1.0",
              "query": "resourcecontainers\r\n| where type =~ 'microsoft.resources/subscriptions'\r\n| project subscriptionId = tolower(subscriptionId), Subscription = name, SubscriptionResourceId = id\r\n| join kind=leftouter (\r\n    resources\r\n    | where type =~ 'microsoft.security/automations'\r\n    | extend subscriptionId = tolower(subscriptionId), Automation = name, AutomationId = id, Location = location,\r\n        EnabledValue = tolower(tostring(properties.isEnabled)),\r\n        ScopeCount = array_length(properties.scopes), ActionCount = array_length(properties.actions), SourceCount = array_length(properties.sources)\r\n    | extend Enabled = case(EnabledValue == 'true', 'On', EnabledValue == 'false', 'Off', 'Unknown / not reported')\r\n    | extend ActionList = iff(coalesce(ActionCount, 0) > 0, properties.actions, dynamic([{}]))\r\n    | mv-expand Action = ActionList limit 2000\r\n    | extend DestinationType = tostring(Action.actionType),\r\n        Workspace = tostring(Action.workspaceResourceId), EventHub = tostring(Action.eventHubResourceId), LogicApp = tostring(Action.logicAppResourceId),\r\n        TrustedValue = tolower(tostring(Action.isTrustedServiceEnabled))\r\n    | extend TrustedService = case(DestinationType !~ 'EventHub', 'Not applicable', TrustedValue == 'true', 'On', TrustedValue == 'false', 'Off', 'Unknown / not reported'),\r\n        Review = strcat(iff(isnull(ActionCount) or ActionCount == 0, 'Destination list missing, empty or invalid; ', ''),\r\n            iff(ActionCount > 2000, 'More than 2000 destinations: inventory incomplete; ', ''),\r\n            iff(DestinationType !in~ ('Workspace', 'EventHub', 'LogicApp'), 'Missing or unsupported destination type; ', ''),\r\n            iff((DestinationType =~ 'Workspace' and isempty(Workspace)) or (DestinationType =~ 'EventHub' and isempty(EventHub)) or (DestinationType =~ 'LogicApp' and isempty(LogicApp)), 'Destination resource ID not reported; ', ''))\r\n    | project subscriptionId, Automation, AutomationId, Enabled, DestinationType, Workspace, EventHub, LogicApp, TrustedService, Review\r\n) on subscriptionId\r\n| extend Automation = iff(isempty(AutomationId), 'Not observed', Automation), Enabled = iff(isempty(AutomationId), 'Not observed', Enabled)\r\n| extend Automation = case(Automation == 'Not observed', Automation, AutomationId matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(resourcegroups/[^/]+/)?providers/microsoft[.]security/automations/[^/]+/?$', AutomationId, strcat('Unresolved: ', Automation))\r\n| extend DestinationType = iff(isempty(DestinationType), 'Not reported', DestinationType),\r\n    Review = case(isempty(AutomationId), 'No visible automation; destination settings not observed.', isempty(Review), 'None observed; verify destination permissions and delivery.', Review)\r\n| extend WorkspaceResource = iff(Workspace matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/resourcegroups/[^/]+/providers/microsoft[.]operationalinsights/workspaces/[^/]+/?$', Workspace, ''),\r\n    EventHubResource = iff(EventHub matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/resourcegroups/[^/]+/providers/microsoft[.]eventhub/namespaces/[^/]+(/[^/]+/[^/]+)*/?$', EventHub, ''),\r\n    LogicAppResource = iff(LogicApp matches regex '(?i)^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/resourcegroups/[^/]+/providers/microsoft[.]logic/workflows/[^/]+/?$', LogicApp, '')\r\n| project Subscription, SubscriptionResourceId, Automation, Enabled, DestinationType, Workspace, WorkspaceResource, EventHub, EventHubResource, LogicApp, LogicAppResource, TrustedService, Review, AutomationId, subscriptionId\r\n| order by Subscription asc, Automation asc, DestinationType asc\r\n",
